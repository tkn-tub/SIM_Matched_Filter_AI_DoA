%[text] # Reconfigurable Metasurface
%[text] Description: This code evaluates \[1, Eq. (16)\] element by element:
%[text] - Eq. (3): incident field at the metasurface under the far-field approximation, Ei(xm,ym) = sum\_n Cn \* exp(j(kx\_pn\*xm + ky\_pn\*ym))
%[text] - Eq. (2): Eo = Ei .\* M, with the aperture function M of Eq. (10) as  M(xm,ym;u,v) = exp(-j(u + k\*xa/za)xm - j(v + k\*ya/za)ym + j\*k\*(xm^2+ym^2)/(2\*za))
%[text] - Eq. (5): Fresnel propagation of Eo over the gap za to the probe
%[text] - Square-law detection: the measurement is |Ea(u,v)|^2 only. No phase. \
%[text] Because Eq. (5) contributes -j\*k\*(xm^2+ym^2)/(2\*za) and Eq.(2) contributes  +j\*k\*(xm^2+ym^2)/(2\*za), the quadratic (lens) terms cancel and the linear terms collapse to exp(j\[(kx\_pn-u)xm + (ky\_pn-v)ym\]) -- which is Eq. (16), peaking at (u,v) = (kx\_pn, ky\_pn). Running the full chain rather than Eq. (16) is what lets the script also reproduce the DEGRADATIONS the paper  reports: probe-position mismatch (Fig. 8) and 2-bit quantisation (\[1,Sec. III\]).
clc;
clearvars;
close all;

%including all parent folders up to the file 'code', this makes visible all
%files within this code
addingPathParentFolderByName('code'); %[output:4ed31ca1]

Parameters;

%% ==================================================================== %%
%  1. GEOMETRY: unit-cell centres of the metasurface Sm (XmYm plane)
%% ==================================================================== %%
xm_RM = ((0:Nx_RM-1) - (Nx_RM-1)/2) * dx_RM;
ym_RM = ((0:Ny_RM-1) - (Ny_RM-1)/2) * dy_RM;
[XM, YM] = ndgrid(xm_RM, ym_RM);
XM = XM(:);  YM = YM(:);          % [Nel_RM x 1] column vectors
Nel_RM = numel(XM);
 
% Source spherical parameters (derived in Parameters_LiAOA from room coordinates)
Nsrc  = numel(srcX_m);
th_s  = deg2rad(srcThetaDeg(:));
ph_s  = deg2rad(srcPhiDeg(:));
R_s   = srcRange_m(:);
a_s   = srcAmp(:);
 
%% ==================================================================== %%
%  1b. GEOMETRY SKETCH -- reproduces the layout of Fig. 1(a) and Fig. 1(b)
%% ==================================================================== %%
if plotGeom %[output:group:4c3f3132]
    plot_RM(xm_RM, ym_RM, Dx_RM, Dy_RM, heigth_RM_m, ... %[output:11a3844a]
                     srcX_m, srcY_m, srcHeight_m, ... %[output:11a3844a]
                     srcThetaDeg, srcPhiDeg, srcRange_m, ... %[output:11a3844a]
                     xa_act, ya_act, za_act, geomMagnify,font); %[output:11a3844a]
end %[output:group:4c3f3132]
%%
%% ==================================================================== %%
%  2. INCIDENT FIELD Ei ARRIVING AT THE METASURFACE
%% ==================================================================== %%
kx_s  = k0 * sin(th_s) .* cos(ph_s);      % kx_pn, below Eq. (3)
ky_s  = k0 * sin(th_s) .* sin(ph_s);      % ky_pn
z_s   = R_s .* cos(th_s);                 % z_pn
 
% Per-source amplitude/phase factor of Eq. (3):
%     (1/(j*lambda)) * z_pn * exp(-j*k*R_n) / R_n^2
% Composed in Section 3 with the 1/(j*lambda*za) prefactor of Eq. (5), the two
% factors of 1/(j*lambda) give the -1/lambda^2 of Cn in Eq. (7).
Cn = a_s .* (z_s ./ R_s.^2) .* exp(-1j*k0*R_s) / (1j*lambda);
 
% Superposition over the N point sources, Eq. (3):
%     Ei(p) = sum_n Cn(n) * exp(j*(kx_pn*xm_p + ky_pn*ym_p))
% Written as an explicit accumulation rather than a matrix product, so the
% sum over n is visible in the code.
Ei = zeros(Nel_RM, 1);
for n = 1:Nsrc
    Ei = Ei + Cn(n) * exp(1j*(kx_s(n)*XM + ky_s(n)*YM));
end
 
%% ==================================================================== %%
%  2b. FAR-FIELD AUDIT
%     Eq. (3) assumes every source is in the Fraunhofer zone of the aperture.
%     A ceiling mount puts sources only a few metres away, so this must be
%     checked explicitly rather than assumed.
%% ==================================================================== %%
if verboseFlag %[output:group:74cc08cc]
    fprintf('--- Far-field audit (Eq. 3 validity) ---\n'); %[output:211803e5]
    fprintf('  aperture diagonal      : %.1f mm\n', hypot(Dx_RM,Dy_RM)*1e3); %[output:624d585d]
    fprintf('  Fraunhofer distance    : %.2f m  (2*D^2/lambda)\n', Rff_RM); %[output:2e371f83]
    fprintf('  source ranges          : %.2f to %.2f m\n', min(R_s), max(R_s)); %[output:46acef3c]
    Dmax_ok = sqrt(min(R_s)*lambda/2)/sqrt(2);   % per-side aperture that would comply
    fprintf('  compliant aperture side: %.1f mm  (= %.1f cells at lambda/2)\n', ... %[output:446e7099]
        Dmax_ok*1e3, Dmax_ok/(lambda/2)); %[output:446e7099]
end %[output:group:74cc08cc]
if any(R_s < Rff_RM)
    warning('LiAOA:farfield', ...
        ['%d of %d sources lie inside the Fraunhofer distance (%.2f m). The plane-wave ' ...
         'model of Eq. (3) is NOT valid for them: the true incident field has residual ' ...
         'wavefront curvature, which broadens the main lobe and biases the peak. ' ...
         'Fix by raising f0, shrinking the aperture, or adding a spherical-wave ' ...
         'incident model.'], sum(R_s < Rff_RM), Nsrc, Rff_RM);
end

%% ==================================================================== %%
%  3. PHASELESS AOA SCAN WITH THE LI2024 MASK
%  Each trial pair (theta,phi) programs M(xm,ym;u,v) from [1, Eq. (10)].
%  The probe receives Ea through the Fresnel integral in [1, Eq. (6)].
%% ==================================================================== %%
thetaScanDeg = thetaScanDeg(:).';
phiScanDeg   = phiScanDeg(:).';
Pscan = zeros(numel(thetaScanDeg), numel(phiScanDeg));
Eascan = zeros(numel(thetaScanDeg), numel(phiScanDeg));

for itheta = 1:numel(thetaScanDeg)
    thetaTrialDeg = thetaScanDeg(itheta);

    for iphi = 1:numel(phiScanDeg)
        phiTrialDeg = phiScanDeg(iphi);

        % [1, Eq. (10)]: mask programmed for the trial spatial frequency.
        M  = aperture_RM(thetaTrialDeg, phiTrialDeg, XM, YM, k0, ...
                         xa_nom, ya_nom, za_nom, phaseBits_RM);

        % [1, Eq. (2)]: outgoing field just after the metasurface.
        Eo = Ei .* M;

        % [1, Eq. (6)]: field collected by the fixed probe antenna.
        Ea = probeField_Eq6(Eo, XM, YM, k0, lambda, dA_RM, ...
                            xa_act, ya_act, za_act);
        Eascan(itheta, iphi) = Ea;
        Pscan(itheta, iphi)  = abs(Ea).^2;
    end
end

[Pmax, idxMax] = max(Pscan(:));
[idxThetaHat, idxPhiHat] = ind2sub(size(Pscan), idxMax);
thetaHatDeg = thetaScanDeg(idxThetaHat);
phiHatDeg   = phiScanDeg(idxPhiHat);

if verboseFlag %[output:group:8e415e88]
    fprintf('--- Li2024 phaseless AOA scan ---\n'); %[output:26b45b3f]
    fprintf('  scan grid        : %d theta x %d phi = %d measurements\n', ... %[output:9728e36a]
        numel(thetaScanDeg), numel(phiScanDeg), numel(Pscan)); %[output:9728e36a]
    fprintf('  strongest peak   : theta = %.2f deg, phi = %.2f deg, |Ea|^2 = %.4e\n', ... %[output:8100dbdf]
        thetaHatDeg, phiHatDeg, Pmax); %[output:8100dbdf]
end %[output:group:8e415e88]

%% ==================================================================== %%
%  4. PLOTS: Fig. 3(c)-style polar AOA intensity map
%% ==================================================================== %%
if plotMap %[output:group:05029946]
    plotAOAMap(thetaScanDeg, phiScanDeg, Pscan, srcThetaDeg, srcPhiDeg, ... %[output:15982c57]
               plotDynRangeDB, font); %[output:15982c57]
end %[output:group:05029946]

if plotCut %[output:group:006af7fe]
    [~, idxThetaCut] = min(abs(thetaScanDeg - thetaHatDeg));
    Pcut = Pscan(idxThetaCut, :);

    figure('Color','w','Name','AOA profile at strongest theta'); %[output:8a533fb5]
    plot(phiScanDeg, 10*log10(Pcut ./ max(Pcut)), 'LineWidth', 1.8); %[output:8a533fb5]
    grid on; box on; %[output:8a533fb5]
    ylim([-plotDynRangeDB 0]); %[output:8a533fb5]
    xlabel('$\phi$ [deg]','FontSize',font,'Interpreter','latex'); %[output:8a533fb5]
    ylabel('normalised $|E_a|^2$ [dB]','FontSize',font,'Interpreter','latex'); %[output:8a533fb5]
    title(sprintf('Profile at $\\theta=%.1f^{\\circ}$', thetaScanDeg(idxThetaCut)), ... %[output:8a533fb5]
          'FontSize',font,'Interpreter','latex'); %[output:8a533fb5]
    set(gca,'FontSize',font); %[output:8a533fb5]
end %[output:group:006af7fe]

if ~isempty(saveTag)
    save(sprintf('LiAOA_%s.mat', saveTag), ...
        'thetaScanDeg', 'phiScanDeg', 'Pscan', 'Eascan', ...
        'thetaHatDeg', 'phiHatDeg', 'srcThetaDeg', 'srcPhiDeg');
end
%%
% ======================= Helper Functions =======================

function addingPathParentFolderByName(targetName)
    % Start from the current directory
    currFolder = pwd;
    found = false;
    
    % Continue searching until you reach the root folder
    while true
        % Get the parent folder
        [parentFolder, currentName] = fileparts(currFolder);
        
        % Check if the current folder's name is the target
        if strcmpi(currentName, targetName)
            found = true;
            break;
        end
        
        % If we've reached the root or no change, exit the loop
        if isempty(parentFolder) || strcmp(currFolder, parentFolder)
            break;
        end
        
        % Move one level up
        currFolder = parentFolder;
    end

    if found
        addpath(genpath(currFolder));
        fprintf('Adding matlab path to: %s\n', currFolder);
    else
        error('Folder named "%s" not found in any parent directory.', targetName);
    end
end

function loadParametersFile()
    if exist('Parameters', 'file') == 2
        Parameters;
        return;
    end

    scriptPath = mfilename('fullpath');
    if isempty(scriptPath)
        scriptDir = pwd;
    else
        scriptDir = fileparts(scriptPath);
    end

    paramFiles = dir(fullfile(scriptDir, 'Parameters*.m'));
    if isempty(paramFiles)
        error('LiAOA:missingParameters', ...
            'No Parameters.m or Parameters*.m file was found next to this script.');
    end

    run(fullfile(paramFiles(1).folder, paramFiles(1).name));
end

function plot_RM(xm_RM, ym_RM, Dx_RM, Dy_RM, RMHeight, ...
                          sX, sY, sHgt, sTh, sPh, sR, ...
                          xa, ya, za, magnify,font)
%plot_RM  Room-coordinate sketch of the measurement geometry,
%  following the layout of Fig. 1(a) of the paper.
%
%  All POSITIONS are true metric room coordinates:
%     z = 0            floor
%     z = sHgt(n)      device Pn
%     z = RMHeight     metasurface Sm, lying flat, boresight pointing down
%     z = RMHeight+za  probe antenna, in the ceiling void behind the
%                      transmitted face
%
%  Only the DRAWN SIZE of the aperture and the probe horn is magnified -- a
%  107 mm aperture is invisible next to a 4 m ceiling otherwise. The
%  magnification factor is stated in the title, and the true aperture size and
%  standoff are printed in the annotation.
%
%  magnify = 'auto'  -> aperture drawn at ~15% of the room's horizontal extent
%          = numeric -> explicit factor (1 = true size)
 
Nsrc = numel(sX);
sX = sX(:); sY = sY(:); sHgt = sHgt(:);
 
% --- horizontal extent of the scene, used for auto-scaling and axis limits --
spanXY = max([max(abs(sX)), max(abs(sY)), Dx_RM, Dy_RM]);
spanXY = max(spanXY, 0.5);
if ischar(magnify) || isstring(magnify)
    if ~strcmpi(magnify,'auto'), error('Unknown geomMagnify: %s', char(magnify)); end
    mag = (0.30*spanXY) / max(Dx_RM, Dy_RM);      % aperture ~ 15% of full width
else
    mag = magnify;
end
mag = max(mag, 1);
 
figure('Color','w','Name','Measurement geometry (room coordinates)', ...
       'Position',[100 100 760 640]);
ax = axes; hold(ax,'on'); grid(ax,'on'); box(ax,'on');
 
% ---------------------------------------------------------------- floor ----
fl = 1.25*spanXY;
patch('XData',[-fl fl fl -fl], 'YData',[-fl -fl fl fl], 'ZData',zeros(1,4), ...
      'FaceColor',[0.92 0.92 0.90], 'FaceAlpha',0.85, ...
      'EdgeColor',[0.7 0.7 0.7], 'DisplayName','floor');
 
% ------------------------------------------------ metasurface Sm (ceiling) --
px = 0.5*Dx_RM*mag;   py = 0.5*Dy_RM*mag;
patch('XData',[-px px px -px], 'YData',[-py -py py py], ...
      'ZData',RMHeight*ones(1,4), 'FaceColor',[0.30 0.55 0.85], 'FaceAlpha',0.45, ...
      'EdgeColor',[0.15 0.30 0.55], 'LineWidth',1.8, ...
      'DisplayName','metasurface S_m');
gx = linspace(-px,px,numel(xm_RM)+1);
gy = linspace(-py,py,numel(ym_RM)+1);
for g = gx
    plot3([g g],[-py py],[RMHeight RMHeight], '-', ...
          'Color',[0.15 0.30 0.55 0.22], 'HandleVisibility','off');
end
for g = gy
    plot3([-px px],[g g],[RMHeight RMHeight], '-', ...
          'Color',[0.15 0.30 0.55 0.22], 'HandleVisibility','off');
end
 
% ------------------------------------------------- probe antenna (above) ----
zaD = za*mag;                                   % standoff, magnified for drawing
drawHorn(RMHeight + zaD, 0.18*px, 0.52*px, 0.55*px, xa*mag, ya*mag);
plot3(xa*mag, ya*mag, RMHeight + zaD, 'v', 'MarkerSize',8, ...
      'MarkerFaceColor',[0.85 0.40 0.10], 'MarkerEdgeColor','k', ...
      'DisplayName','probe antenna');
plot3([0 xa*mag],[0 ya*mag],[RMHeight RMHeight+zaD], '-', ...
      'Color',[0.85 0.40 0.10], 'LineWidth',1.6, 'HandleVisibility','off');
 
% ----------------------------------------------------- boresight (z_m) ------
plot3([0 0],[0 0],[0 RMHeight], ':', 'Color',[0.25 0.25 0.25], ...
      'LineWidth',1.2, 'HandleVisibility','off');
text(0,0,0.5*RMHeight,'$z_m$ (boresight)','FontSize',font,'Color',[0.25 0.25 0.25],'Interpreter','latex');
 
% ------------------------------------------- point sources (devices) --------
cmap = lines(max(Nsrc,3));
zTxt = 0.055*RMHeight;
for n = 1:Nsrc
    % ray device -> metasurface centre
    plot3([sX(n) 0],[sY(n) 0],[sHgt(n) RMHeight], '--', ...
          'Color',[0.45 0.45 0.45 0.75], 'LineWidth',1.1, 'HandleVisibility','off');
    % drop line to the floor, to fix the device in the room visually'FontSize',8.5
    plot3([sX(n) sX(n)],[sY(n) sY(n)],[0 sHgt(n)], ':', ...
          'Color',[0.55 0.55 0.55], 'LineWidth',1.0, 'HandleVisibility','off');
    plot3(sX(n), sY(n), 0, 'k.', 'MarkerSize',8, 'HandleVisibility','off');
    % the device itself
    plot3(sX(n), sY(n), sHgt(n), 'p', 'MarkerSize',16, ...
          'MarkerFaceColor',cmap(n,:), 'MarkerEdgeColor','k', ...
          'DisplayName',sprintf('P_%d', n));
    % label, staggered in height so neighbouring devices do not overprint
    stag = zTxt * (1 + 1.15*mod(n-1,2));

text(sX(n), sY(n), sHgt(n)+stag, ...
    {sprintf('$P_{%d}$: $\\theta=%.1f^{\\circ}$', n, sTh(n)), ...
     sprintf('$\\ \\phi=%.1f^{\\circ}$', sPh(n)), ...
     sprintf('$R=%.2f\\,\\mathrm{m}$', sR(n))}, ...
    'FontSize',font-5, 'Interpreter','latex', ...
    'HorizontalAlignment','left', 'VerticalAlignment','bottom', ...
    'Margin',0.5, 'Clipping','on');
end
 
% ------------------------------------------------------------- cosmetics ----
xlabel('$x$ [m]','FontSize',font,'Interpreter','latex');
ylabel('$y$ [m]','FontSize',font,'Interpreter','latex');
zlabel('$z$ [m]','FontSize',font,'Interpreter','latex');
xlim([-fl fl]); ylim([-fl fl]); zlim([0 RMHeight*1.18]);
% daspect([1 1 1]);
view(-37, 16); rotate3d(ax,'on');
% legend('Location','northeastoutside','FontSize',font);
set(gca,'FontSize',font);
%title({sprintf('Geometry: RM on ceiling at %.2f m, devices at %.2f m', ...
       %          RMHeight, mean(sHgt)), ...
       % sprintf(['aperture %.1f x %.1f mm and standoff z_a = %.1f mm drawn ' ...
       %          'x%.0f for visibility'], Dx_RM*1e3, Dy_RM*1e3, za*1e3, mag)}, ...
       % 'FontWeight','normal','FontSize',10);
   
end
 
 
function drawHorn(zc, aIn, aOut, len, xc, yc)
%DRAWHORN  Trapezoidal-frustum sketch of the probe horn, throat at the
%  metasurface side, aperture facing up into the ceiling void. Cosmetic only.
zi = zc;  zo = zc + len;
Vin  = [-aIn -aIn zi; aIn -aIn zi; aIn aIn zi; -aIn aIn zi];
Vout = [-aOut -aOut zo; aOut -aOut zo; aOut aOut zo; -aOut aOut zo];
Vin(:,1) = Vin(:,1)+xc;  Vin(:,2) = Vin(:,2)+yc;
Vout(:,1)= Vout(:,1)+xc; Vout(:,2)= Vout(:,2)+yc;
V = [Vin; Vout];
F = [1 2 6 5; 2 3 7 6; 3 4 8 7; 4 1 5 8; 5 6 7 8];
patch('Vertices',V,'Faces',F,'FaceColor',[0.85 0.55 0.25],'FaceAlpha',0.60, ...
      'EdgeColor',[0.5 0.3 0.1],'HandleVisibility','off');
end

function Ea = probeField_Eq6(Eo, XM, YM, k0, lambda, dA, xa, ya, za)
    %PROBEFIELD_EQ6  Fresnel propagation from the RM aperture to the probe.
    %
    % This is the discrete unit-cell version of [1, Eq. (6)]. Constant phase
    % terms are retained for completeness, although only |Ea|^2 is measured.
    quadPhase = exp( ...
        1j*k0*(xa*XM + ya*YM)/za ...
        -1j*k0*(XM.^2 + YM.^2)/(2*za));

    constPhase = exp(-1j*k0*(za + (xa^2 + ya^2)/(2*za))) ...
               / (1j*lambda*za);

    Ea = constPhase * sum(Eo .* quadPhase) * dA;
end

function plotAOAMap(thetaScanDeg, phiScanDeg, Pscan, srcThetaDeg, srcPhiDeg, ...
                    plotDynRangeDB, font)
    %PLOTAOAMAP  Polar AOA map with theta as radius and phi as angle.
    PnormDB = 10*log10(Pscan ./ max(Pscan(:)));
    PnormDB = max(PnormDB, -plotDynRangeDB);

    [PHI, THETA] = meshgrid(deg2rad(phiScanDeg), thetaScanDeg);
    Xp = THETA .* cos(PHI);
    Yp = THETA .* sin(PHI);

    figure('Color','w','Name','Li2024 phaseless AOA map');
    surf(Xp, Yp, PnormDB, 'EdgeColor', 'none');
    view(2); axis equal tight; box on;
    colormap turbo; colorbar;
    caxis([-plotDynRangeDB 0]);
    hold on;

    srcX = srcThetaDeg(:) .* cos(deg2rad(srcPhiDeg(:)));
    srcY = srcThetaDeg(:) .* sin(deg2rad(srcPhiDeg(:)));
    plot3(srcX, srcY, ones(size(srcX)), 'wo', ...
        'MarkerFaceColor', 'k', 'MarkerSize', 7, 'LineWidth', 1.2);

    xlabel('$\theta\cos\phi$ [deg]','FontSize',font,'Interpreter','latex');
    ylabel('$\theta\sin\phi$ [deg]','FontSize',font,'Interpreter','latex');
    title('Retrieved AOA, normalised $|E_a|^2$', ...
          'FontSize',font,'Interpreter','latex');
    set(gca,'FontSize',font);
end

function M = aperture_RM(theta_deg, phi_deg, XM, YM, k0, xa, ya, za, phaseBits_RM)
    %APERTURE_RM  Aperture function of the reconfigurable metasurface, [1, Eq. (10)].
    %
    %   M = aperture_RM(theta_deg, phi_deg, XM, YM, k0, xa, ya, za, phaseBits_RM)
    %
    %   [1, Eq. (10)] is written in terms of the spatial frequencies (u,v):
    %       M(xm,ym;u,v) = exp( -j(u + k*xa/za)*xm ...
    %                           -j(v + k*ya/za)*ym ...
    %                           +j*k*(xm^2 + ym^2)/(2*za) )
    %   Here it is parameterised instead by the steering angles that generate them,
    %       u = k*sin(theta)*cos(phi),   v = k*sin(theta)*sin(phi),
    %   since (theta,phi) are the quantities actually swept.
    %
    %   theta_deg, phi_deg : steering direction of THIS RM configuration [deg].
    %                        These are the trial angles being probed, not the
    %                        source angles srcThetaDeg / srcPhiDeg.
    %   XM, YM             : unit-cell centres, [Nel_RM x 1] each.
    %   xa, ya, za         : probe position the RM is programmed for (the NOMINAL
    %                        one; a mismatch against the true probe position is
    %                        what Fig. 8 of [1] studies).
    %   phaseBits_RM       : Inf for continuous phase, 2 for the 2-bit prototype
    %                        of [1, Sec. III].
    %
    %   Returns M as [Nel_RM x 1], with |M| = 1 for every unit cell, so that the
    %   Schwarz equality condition of [1, Eq. (13)-(14)] is attainable.
    
    theta = deg2rad(theta_deg);
    phi   = deg2rad(phi_deg);
    
    u = k0 * sin(theta) * cos(phi);          % spatial frequency along xm
    v = k0 * sin(theta) * sin(phi);          % spatial frequency along ym
    
    % Phase of [1, Eq. (10)], term by term
    Phi = -(u + k0*xa/za) * XM ...           % linear ramp along xm
        -(v + k0*ya/za) * YM ...           % linear ramp along ym
        + k0*(XM.^2 + YM.^2)/(2*za);       % quadratic (lens) term focusing on the probe
    
    % Phase quantisation of the RM
    if ~isinf(phaseBits_RM)
        step = 2*pi / 2^phaseBits_RM;
        Phi  = round(mod(Phi, 2*pi) / step) * step;
    end
    
    M = exp(1j*Phi);                         % [Nel_RM x 1], |M| = 1
end
%[text] ## References
%[text] \[1\] W. Li, N. Wang, and J. Qi, "Direct Angle of Arrival (AOA) Estimation Using a Metasurface Antenna With Single Frequency Phaseless Measurements Obeyed Schwarz Inequality," IEEE Transactions on Microwave Theory and Techniques, vol. 72, no. 4, pp. 2677–2685, Apr. 2024, doi: 10.1109/TMTT.2023.3314063.
%[text] 
%[text] 

%[appendix]{"version":"1.0"}
%---
%[metadata:view]
%   data: {"layout":"onright","rightPanelPercent":37.9}
%---
%[output:4ed31ca1]
%   data: {"dataType":"text","outputData":{"text":"Adding matlab path to: D:\\code\\SIM_Matched_Filter_AI_DoA\\code\n","truncated":false}}
